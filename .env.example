# Base da instância GitLab CE self-hosted.
# Sem barra no final. Se você colar com /api/v4 no fim, o server remove sozinho.
GITLAB_URL=https://gitlab.empresa.com

# Personal Access Token.
#   read_api -> cobre as tools 1-7 (leitura)
#   api      -> obrigatório para comment_on_mr, comment_on_mr_line, reply_to_mr_discussion
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Read-only por default. Só 'false' (exato) libera as 3 tools de escrita.
GITLAB_READ_ONLY=true

# Opcional: CA privada / cert self-signed em PEM.
# GITLAB_CA_CERT=/etc/ssl/certs/empresa-ca.pem

# Opcional: timeout por request, em ms.
# GITLAB_TIMEOUT_MS=20000
